.ipynb_checkpoints/
*-checkpoint.ipynb
*-checkpoint.*
.virtual_documents/

# ------------------------------------------------------------------------------
# 4. Databases, Vector Stores & Runtime State
# ------------------------------------------------------------------------------
# ChromaDB persistence
backend/data/chromadb/
backend/data/chromadb*

# Kùzu Graph Database (matches directory, standalone file, and WAL)
backend/data/kuzu_db
backend/data/kuzu_db/
backend/data/kuzu_db*

# SQLite Database & Journal / WAL files
backend/data/chatbox.db*
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal

# Docker Sandbox Output & Temporary Runner Scripts
backend/data/sandbox/
backend/data/sandbox/**

# Temporary Scratchpads
scratch/
/scratch/

# ------------------------------------------------------------------------------
# 5. Scientific Datasets & Trajectories (Large / Restricted Files)
# ------------------------------------------------------------------------------
# Restricted Anatase Dataset (strictly isolated to Docker container)
backend/data/Anatase_TiO2_Water_MolecularAdsorbedWater.extxyz
backend/data/*.extxyz

# Trajectories and atomic coordinates (ExtXYZ, XYZ, LAMMPS Trajectories, NetCDF, etc.)
*.extxyz
*.xyz
*.lammpstrj
*.dump
dump.*
*.dcd
*.xtc
*.trr
*.trj
*.traj
*.netcdf
*.nc

# ------------------------------------------------------------------------------
