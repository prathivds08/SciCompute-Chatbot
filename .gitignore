# ------------------------------------------------------------------------------
# Raw coordinates, forces, virial, box arrays
*.raw
*.npy

# Frozen model graphs (TensorFlow graphs generated by DeePMD freeze)
*.pb

# DeePMD / TensorFlow model checkpoints
checkpoint
checkpoint.*
model.ckpt*
lcurve.out

